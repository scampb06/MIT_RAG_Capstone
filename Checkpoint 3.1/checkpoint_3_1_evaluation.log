utable_to_retrieval": true}, {"text": "The longest gap between first and second nomination was 42 years.", "cited_source": "List_of_Academy_Award_records.html", "grounded": true, "citation_supported": true, "attributable_to_retrieval": false}, {"text": "That 42-year gap was for Judd Hirsch.", "cited_source": "List_of_Academy_Award_records.html", "grounded": true, "citation_supported": true, "attributable_to_retrieval": false}, {"text": "Judd Hirsch’s first nomination was for Ordinary People (1980).", "cited_source": "List_of_Academy_Award_records.html", "grounded": true, "citation_supported": true, "attributable_to_retrieval": false}, {"text": "Judd Hirsch’s second nomination was for The Fabelmans (2023).", "cited_source": "List_of_Academy_Award_records.html", "grounded": true, "citation_supported": true, "attributable_to_retrieval": false}], "claim_count": 5, "graded_groundedness_score": 1.0, "faithfulness": "pass", "citation_support_rate": 1.0, "chunk_attribution_score": 0.2, "source_hit_at_k": 1, "source_recall_at_k": 1.0, "source_precision_at_k": 0.6666666666666666, "source_recall_strict": 1.0, "all_required_present": true, "response_quote_count": 0, "quote_fidelity_rate": null, "quote_attribution_accuracy": null, "citation_count": 1, "citation_precision": 1.0, "unsupported_citation_rate": 0.0, "refusal_outcome": "n/a", "answer_latency_seconds": 1.7767034000135027, "judge_latency_seconds": 4.844443100009812, "total_latency_seconds": 7.936581600020872, "input_tokens": 185994, "output_tokens": 510, "total_tokens": 186504, "estimated_cost_usd": 0.1417905}
